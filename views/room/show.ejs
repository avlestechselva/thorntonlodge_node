<section class="banner scroll-animate parallax-hero" style="background: linear-gradient(rgba(44, 62, 80, 0.7), rgba(44, 62, 80, 0.7)), url(<%= room.cover_image %>) no-repeat center; background-size: cover; padding: 160px 0 120px 0; background-attachment: fixed;">
    <div class="container"><div class="row justify-content-center"><div class="col-lg-10 text-center hero-content">
        <h1 style="font-size: 52px; font-weight: 700; color: white; text-shadow: 2px 2px 10px rgba(0,0,0,0.5);"><%= room.title %></h1>
    </div></div></div>
</section>

<section style="background: linear-gradient(135deg, #F0F7FA 0%, #E8F4F8 100%); padding: 100px 0;">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-md-12 scroll-animate-left">
                <div style="background: white; border-radius: 20px; padding: 50px; box-shadow: 0 10px 40px rgba(0,0,0,0.08);">
                    <h2 style="font-size: 32px; font-weight: 700; color: #2C3E50; margin-bottom: 25px;"><%= room.title %></h2>
                    <div style="font-size: 17px; line-height: 1.9; color: #555;"><%- room.body %></div>
                </div>
            </div>
            <div class="col-lg-4 col-md-12 scroll-animate-right">
                <div style="background: linear-gradient(135deg, #7BA5C7 0%, #6B94B5 100%); border-radius: 20px; padding: 40px; color: white; box-shadow: 0 15px 50px rgba(123, 165, 199, 0.3); margin-bottom: 30px;">
                    <h4 style="font-size: 22px; font-weight: 700; margin-bottom: 20px; color: white;">Interested?</h4>
                    <p style="color: rgba(255,255,255,0.9); line-height: 1.7; margin-bottom: 25px;">Contact us to find out more about this room and arrange a visit.</p>
                    <a href="/contact" style="display: block; background: white; color: #7BA5C7; padding: 15px 25px; border-radius: 50px; text-align: center; font-weight: 700; text-decoration: none;">Enquire Now</a>
                </div>
                <div style="background: white; border-radius: 20px; padding: 30px; box-shadow: 0 10px 40px rgba(0,0,0,0.08);">
                    <h4 style="font-weight: 700; color: #2C3E50; margin-bottom: 15px;">Other Rooms</h4>
                    <a href="/projects" style="color: #7BA5C7; text-decoration: none; font-weight: 600;">View All Rooms &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</section>
