<div class="right_col" role="main">
    <div class="">
        <% if (error) { %><div class="alert alert-danger alert-dismissible"><button type="button" class="close" data-dismiss="alert"><i class="fa fa-times"></i></button><%= error %></div><% } %>
        <div class="page-title"><div class="title_left"><h3>Create Post</h3></div></div>
        <div class="clearfix"></div>
        <form action="/admin/posts" method="POST" class="form-horizontal form-label-left" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-12">
                <div class="x_panel">
                    <div class="x_title"><h2>Post Information</h2><div class="clearfix"></div></div>
                    <div class="x_content"><br>
                        <div class="form-group">
                            <label class="control-label col-md-3 col-sm-3 col-xs-12">Post Category</label>
                            <div class="col-md-9 col-sm-9 col-xs-12">
                                <select class="form-control" name="category_id">
                                    <% if (tags && tags.length > 0) { %>
                                    <% tags.forEach((tag, k) => { %>
                                    <option value="<%= tag._id %>" <%= k === 0 ? 'selected' : '' %>><%= tag.name %></option>
                                    <% }) %>
                                    <% } %>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3 col-sm-3 col-xs-12">Post Title</label>
                            <div class="col-md-9 col-sm-9 col-xs-12">
                                <input type="text" name="title" class="form-control" placeholder="Post title ..." required oninput="autoSlug(this.value)">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3 col-sm-3 col-xs-12">Title Slug</label>
                            <div class="col-md-9 col-sm-9 col-xs-12">
                                <input type="text" id="slug" name="slug" class="form-control" placeholder="Title slug ..." required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3 col-sm-3 col-xs-12">Author</label>
                            <div class="col-md-9 col-sm-9 col-xs-12">
                                <input type="text" name="author" class="form-control" value="Admin" placeholder="Author Name ...">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="x_panel">
                    <div class="x_title"><h2>Cover Image</h2><div class="clearfix"></div></div>
                    <div class="x_content"><br>
                        <div class="form-group">
                            <div class="col-xs-12"><input name="cover_image" accept="image/*" type="file" class="form-control"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="x_panel">
                    <div class="x_title"><h2>Post Visibility</h2><div class="clearfix"></div></div>
                    <div class="x_content"><br>
                        <div class="form-group">
                            <label class="control-label col-md-3 col-sm-3 col-xs-12">Status</label>
                            <div class="col-md-9 col-sm-9 col-xs-12">
                                <select class="form-control" name="status">
                                    <option value="DRAFT" selected>DRAFT</option>
                                    <option value="PUBLISHED">PUBLISHED</option>
                                    <option value="PENDING">PENDING</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3 col-sm-3 col-xs-12">Featured</label>
                            <div class="col-md-9 col-sm-9 col-xs-12"><br>
                                <input type="checkbox" name="featured" value="true" checked>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="x_panel">
                    <div class="x_title"><h2>Excerpt</h2><div class="clearfix"></div></div>
                    <div class="x_content">
                        <div class="form-group">
                            <textarea name="description" class="form-control" rows="4" placeholder="Excerpt text ..." required></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="x_panel">
                    <div class="x_title"><h2>Post Body</h2><div class="clearfix"></div></div>
                    <div class="x_content">
                        <div class="form-group">
                            <textarea name="body" id="article-ckeditor" class="form-control" rows="10" placeholder="Post content ..."></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="x_panel">
                    <div class="x_title"><h2>SEO Info</h2><div class="clearfix"></div></div>
                    <div class="x_content">
                        <div class="form-group">
                            <label class="control-label col-md-3 col-sm-3 col-xs-12">SEO Title</label>
                            <div class="col-md-9 col-sm-9 col-xs-12"><input type="text" name="seotitle" id="seotl" class="form-control" placeholder="SEO Title ..."></div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3 col-sm-3 col-xs-12">Keywords</label>
                            <div class="col-md-9 col-sm-9 col-xs-12"><input type="text" name="keywords" class="form-control" placeholder="Keywords ..."></div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3 col-sm-3 col-xs-12">Meta Description</label>
                            <div class="col-md-9 col-sm-9 col-xs-12"><textarea name="meta_description" maxlength="150" class="form-control" rows="3" placeholder="SEO Meta description ..."></textarea></div>
                        </div>
                        <div class="ln_solid"></div>
                        <div class="form-group text-center">
                            <div class="col-md-9 col-sm-9 col-xs-12 col-md-offset-3">
                                <a href="/admin/posts" class="btn btn-danger"><i class="ace-icon fa fa-arrow-left"></i> Back</a>
                                <button type="reset" class="btn btn-warning"><i class="ace-icon fa fa-refresh"></i> Reset</button>
                                <button type="submit" class="btn btn-success"><i class="ace-icon fa fa-check"></i> Save</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </form>
    </div>
</div>

<script src="/Adminassets/ckeditor/ckeditor.js"></script>
<script>
if (typeof CKEDITOR !== 'undefined') { CKEDITOR.replace('article-ckeditor'); }
function autoSlug(val) {
    var slug = val.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    document.getElementById('slug').value = slug;
    document.getElementById('seotl').value = val;
}
</script>
