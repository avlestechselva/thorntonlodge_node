<link href="/Adminassets/vendors/datatables.net-bs/css/dataTables.bootstrap.min.css" rel="stylesheet">
<link href="/Adminassets/vendors/datatables.net-buttons-bs/css/buttons.bootstrap.min.css" rel="stylesheet">
<link href="/Adminassets/vendors/datatables.net-responsive-bs/css/responsive.bootstrap.min.css" rel="stylesheet">

<div class="right_col" role="main">
    <div class="">
        <% if (success) { %><div class="alert alert-success alert-dismissible"><button type="button" class="close" data-dismiss="alert"><i class="fa fa-times"></i></button><%= success %></div><% } %>
        <% if (error) { %><div class="alert alert-danger alert-dismissible"><button type="button" class="close" data-dismiss="alert"><i class="fa fa-times"></i></button><%= error %></div><% } %>
        <div class="page-title"><div class="title_left"><h3>Blog Posts</h3></div></div>
        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-12">
                <div class="x_panel">
                    <div class="x_title"><h2>Posts List</h2><div class="clearfix"></div></div>
                    <div class="x_content">
                        <div class="clearfix" style="margin-bottom:15px;">
                            <a href="/admin/posts/create" class="btn btn-sm btn-success btn-space"><i class="ace-icon fa fa-plus"></i> Add New Post</a>
                            <a href="/admin/posts" class="btn btn-space btn-sm btn-info"><i class="ace-icon fa fa-refresh"></i> Reload</a>
                        </div>
                        <table id="datatable-buttons" class="table table-striped table-bordered">
                            <thead><tr><th>#</th><th>Image</th><th>Title</th><th>Category</th><th>Status</th><th>Updated</th><th>Action</th></tr></thead>
                            <tbody>
                            <% if (posts && posts.length > 0) { %>
                            <% posts.forEach((post, k) => { %>
                            <tr>
                                <td><%= k+1 %></td>
                                <td><img width="80px" height="55px" src="<%= post.image %>" alt="<%= post.title %>"></td>
                                <td><div class="truncate-ellipsis-title"><%= post.title %></div></td>
                                <td><%= post.category ? post.category.name : '' %></td>
                                <td><span class="label label-<%= post.status === 'PUBLISHED' ? 'success' : post.status === 'DRAFT' ? 'warning' : 'info' %>"><%= post.status %></span></td>
                                <td><%= new Date(post.updatedAt).toLocaleDateString('en-GB') %></td>
                                <td>
                                    <div class="action_button">
                                        <a title="View" class="label label-info lbl_pad" href="/tag-<%= post.category ? post.category.slug : 'news' %>/<%= post.slug %>" target="_blank"><i class="ace-icon fa fa-eye"></i></a>
                                        <a title="Edit" class="label label-success lbl_pad" href="/admin/posts/<%= post._id %>/edit"><i class="ace-icon fa fa-pencil"></i></a>
                                        <a title="Delete" class="label label-danger lbl_pad" href="#" data-toggle="modal" onclick="deleteItem('<%= post._id %>','<%= post.title %>')" data-target=".bs-delete-modal-sm">&nbsp;<i class="ace-icon fa fa-trash-o"></i>&nbsp;</a>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr><td colspan="7"><div class="alert alert-warning">No posts found.</div></td></tr>
                            <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete modal -->
<div class="modal fade bs-delete-modal-sm" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm"><div class="modal-content">
        <div class="modal-header" style="background:black;"><button type="button" class="close" data-dismiss="modal"><span>×</span></button><h4 class="modal-title"><i class="ace-icon fa fa-info-circle"></i> Confirm Delete</h4></div>
        <div class="modal-body"><h5 id="tagid"></h5><h5 id="tagname"></h5><h4><strong>Are you sure want to delete?</strong></h4></div>
        <div class="modal-footer">
            <button type="button" class="btn btn-primary" data-dismiss="modal">No</button>
            <button type="button" class="btn btn-danger id-btn-delete" data-dismiss="modal">Yes</button>
        </div>
    </div></div>
</div>

<script src="/Adminassets/vendors/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/Adminassets/vendors/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
<script>
$(document).ready(function(){ if($('#datatable-buttons').length){ $('#datatable-buttons').DataTable(); } });
function deleteItem(id, title) {
    document.getElementById("tagid").innerHTML = 'ID: ' + id;
    document.getElementById("tagname").innerHTML = 'Title: ' + title;
    $(".id-btn-delete").off('click').on('click', function(){ location.href = '/admin/posts/' + id + '/delete'; });
}
</script>
