<style>.form-help-text { font-size: 12px; color: #777; margin-top: 5px; display: block; }</style>
<div class="right_col" role="main">
    <div class="">
        <% if (error) { %><div class="alert alert-danger alert-dismissible"><button type="button" class="close" data-dismiss="alert"><i class="fa fa-times"></i></button><%= error %></div><% } %>
        <div class="page-title"><div class="title_left"><h3>Edit Staff Category</h3></div></div>
        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                <div class="x_panel">
                    <div class="x_title"><h2>Staff Category Information</h2><div class="clearfix"></div></div>
                    <div class="x_content"><br>
                        <form action="/admin/staff-categories/<%= category._id %>?_method=PUT" method="POST" class="form-horizontal form-label-left">
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Name</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <input type="text" name="name" class="form-control" value="<%= category.name %>" required>
                                    <small class="form-help-text">Internal category name</small>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Section Title</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <input type="text" name="section_title" class="form-control" value="<%= category.section_title %>">
                                    <small class="form-help-text">Display title on team page (leave empty to use name)</small>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Parent Section</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <input type="text" name="parent_section" class="form-control" value="<%= category.parent_section %>" placeholder="e.g., Management Team">
                                    <small class="form-help-text">Group under a parent section. Leave empty for standalone.</small>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Display Type</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <select name="display_type" class="form-control">
                                        <% ['card-grid','name-list','individual-cards'].forEach(dt => { %>
                                        <option value="<%= dt %>" <%= category.display_type === dt ? 'selected' : '' %>><%= dt %></option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Description</label>
                                <div class="col-md-9 col-sm-9 col-xs-12"><textarea name="description" class="form-control" rows="3"><%= category.description %></textarea></div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Order</label>
                                <div class="col-md-9 col-sm-9 col-xs-12"><input type="number" name="order" class="form-control" value="<%= category.order %>"></div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Active</label>
                                <div class="col-md-9 col-sm-9 col-xs-12"><br>
                                    <input type="checkbox" name="is_active" value="true" <%= category.is_active ? 'checked' : '' %>>
                                </div>
                            </div>
                            <div class="ln_solid"></div>
                            <div class="form-group text-center">
                                <div class="col-md-9 col-sm-9 col-xs-12 col-md-offset-3">
                                    <a href="/admin/staff-categories" class="btn btn-danger"><i class="ace-icon fa fa-arrow-left"></i> Back</a>
                                    <button type="submit" class="btn btn-success"><i class="ace-icon fa fa-check"></i> Save Changes</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
