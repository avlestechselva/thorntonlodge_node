<style>
.form-help-text { font-size: 12px; color: #777; margin-top: 5px; display: block; }
</style>
<link href="/Adminassets/vendors/datatables.net-bs/css/dataTables.bootstrap.min.css" rel="stylesheet">
<div class="right_col" role="main">
    <div class="">
        <% if (success) { %><div class="alert alert-success alert-dismissible"><button type="button" class="close" data-dismiss="alert"><i class="fa fa-times"></i></button><%= success %></div><% } %>
        <% if (error) { %><div class="alert alert-danger alert-dismissible"><button type="button" class="close" data-dismiss="alert"><i class="fa fa-times"></i></button><%= error %></div><% } %>
        <div class="page-title"><div class="title_left"><h3>Staff Categories <small>(Team Section Management)</small></h3></div></div>
        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-5">
                <div class="x_panel">
                    <div class="x_title"><h2>Add New Staff Category</h2><div class="clearfix"></div></div>
                    <div class="x_content"><br>
                        <form action="/admin/staff-categories" method="POST" class="form-horizontal form-label-left">
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Name</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <input type="text" name="name" class="form-control" placeholder="Category name ..." required>
                                    <small class="form-help-text">Internal category name (e.g., "Managing Director")</small>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Section Title</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <input type="text" name="section_title" class="form-control" placeholder="Display title ...">
                                    <small class="form-help-text">Display title on team page</small>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Parent Section</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <input type="text" name="parent_section" class="form-control" placeholder="e.g., Management Team">
                                    <small class="form-help-text">Group under a parent section. Leave empty for standalone.</small>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Display Type</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <select name="display_type" class="form-control">
                                        <option value="card-grid">Card Grid</option>
                                        <option value="name-list">Name List</option>
                                        <option value="individual-cards">Individual Cards</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Description</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <textarea name="description" class="form-control" rows="3" placeholder="Optional description ..."></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Order</label>
                                <div class="col-md-9 col-sm-9 col-xs-12"><input type="number" name="order" class="form-control" value="0"></div>
                            </div>
                            <div class="ln_solid"></div>
                            <div class="form-group text-center">
                                <div class="col-md-9 col-sm-9 col-xs-12 col-md-offset-3">
                                    <button type="submit" class="btn btn-success"><i class="ace-icon fa fa-check"></i> Save</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="x_panel">
                    <div class="x_title"><h2>Staff Categories List</h2><div class="clearfix"></div></div>
                    <div class="x_content">
                        <table id="datatable-buttons" class="table table-striped table-bordered">
                            <thead><tr><th>#</th><th>Name</th><th>Parent Section</th><th>Display Type</th><th>Active</th><th>Action</th></tr></thead>
                            <tbody>
                            <% if (categories && categories.length > 0) { %>
                            <% categories.forEach((cat, k) => { %>
                            <tr>
                                <td><%= k+1 %></td>
                                <td><%= cat.name %></td>
                                <td><%= cat.parent_section || '-' %></td>
                                <td><%= cat.display_type %></td>
                                <td><span class="label label-<%= cat.is_active ? 'success' : 'warning' %>"><%= cat.is_active ? 'Yes' : 'No' %></span></td>
                                <td>
                                    <a title="Edit" class="label label-success lbl_pad" href="/admin/staff-categories/<%= cat._id %>/edit"><i class="ace-icon fa fa-pencil"></i></a>
                                    <a title="Delete" class="label label-danger lbl_pad" href="#" data-toggle="modal" onclick="deleteItem('<%= cat._id %>','<%= cat.name %>')" data-target=".bs-delete-modal-sm">&nbsp;<i class="ace-icon fa fa-trash-o"></i>&nbsp;</a>
                                </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr><td colspan="6"><div class="alert alert-warning">No staff categories found.</div></td></tr>
                            <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade bs-delete-modal-sm" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm"><div class="modal-content">
        <div class="modal-header" style="background:black;"><button type="button" class="close" data-dismiss="modal"><span>×</span></button><h4 class="modal-title">Confirm Delete</h4></div>
        <div class="modal-body"><h5 id="tagid"></h5><h5 id="tagname"></h5><h4><strong>Are you sure?</strong></h4></div>
        <div class="modal-footer">
            <button type="button" class="btn btn-primary" data-dismiss="modal">No</button>
            <button type="button" class="btn btn-danger id-btn-delete" data-dismiss="modal">Yes</button>
        </div>
    </div></div>
</div>
<script src="/Adminassets/vendors/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/Adminassets/vendors/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
<script>
$(document).ready(function(){ if($('#datatable-buttons').length){ $('#datatable-buttons').DataTable(); } });
function deleteItem(id, name) {
    document.getElementById("tagid").innerHTML = 'ID: ' + id;
    document.getElementById("tagname").innerHTML = 'Name: ' + name;
    $(".id-btn-delete").off('click').on('click', function(){ location.href = '/admin/staff-categories/' + id + '/delete'; });
}
</script>
