<div class="right_col" role="main">
    <div class="">
        <% if (error) { %><div class="alert alert-danger alert-dismissible"><button type="button" class="close" data-dismiss="alert"><i class="fa fa-times"></i></button><%= error %></div><% } %>
        <div class="page-title"><div class="title_left"><h3>Upload Gallery Image</h3></div></div>
        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                <div class="x_panel">
                    <div class="x_title"><h2>Gallery Image Information</h2><div class="clearfix"></div></div>
                    <div class="x_content"><br>
                        <form action="/admin/galleries" method="POST" class="form-horizontal form-label-left" enctype="multipart/form-data">
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Gallery Tag</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <select class="form-control" name="tag_id">
                                        <% if (tags && tags.length > 0) { %>
                                        <% tags.forEach((tag, k) => { %>
                                        <option value="<%= tag._id %>" <%= k === 0 ? 'selected' : '' %>><%= tag.title %></option>
                                        <% }) %>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Title</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <input type="text" name="title" class="form-control" placeholder="Image title ..." required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Image</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <input type="file" name="gallery_image" accept="image/*" class="form-control" required>
                                </div>
                            </div>
                            <div class="ln_solid"></div>
                            <div class="form-group text-center">
                                <div class="col-md-9 col-sm-9 col-xs-12 col-md-offset-3">
                                    <a href="/admin/galleries" class="btn btn-danger"><i class="ace-icon fa fa-arrow-left"></i> Back</a>
                                    <button type="submit" class="btn btn-success"><i class="ace-icon fa fa-upload"></i> Upload</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
