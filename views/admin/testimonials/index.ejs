<link href="/Adminassets/vendors/datatables.net-bs/css/dataTables.bootstrap.min.css" rel="stylesheet">
<div class="right_col" role="main">
    <div class="">
        <% if (success) { %><div class="alert alert-success alert-dismissible"><button type="button" class="close" data-dismiss="alert"><i class="fa fa-times"></i></button><%= success %></div><% } %>
        <% if (error) { %><div class="alert alert-danger alert-dismissible"><button type="button" class="close" data-dismiss="alert"><i class="fa fa-times"></i></button><%= error %></div><% } %>
        <div class="page-title"><div class="title_left"><h3>Testimonials</h3></div></div>
        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-5">
                <div class="x_panel">
                    <div class="x_title"><h2>Add New Testimonial</h2><div class="clearfix"></div></div>
                    <div class="x_content"><br>
                        <form action="/admin/testimonials" method="POST" class="form-horizontal form-label-left" enctype="multipart/form-data">
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Name</label>
                                <div class="col-md-9 col-sm-9 col-xs-12"><input type="text" name="name" class="form-control" placeholder="Name ..." required></div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Occupation</label>
                                <div class="col-md-9 col-sm-9 col-xs-12"><input type="text" name="occupation" class="form-control" placeholder="Occupation ..."></div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Comment</label>
                                <div class="col-md-9 col-sm-9 col-xs-12"><textarea name="comment" class="form-control" rows="5" placeholder="Comment ..." required></textarea></div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Image</label>
                                <div class="col-md-9 col-sm-9 col-xs-12"><input type="file" name="testimonial_image" accept="image/*" class="form-control"></div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Status</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <select name="status" class="form-control">
                                        <option value="active">Active</option>
                                        <option value="inactive">Inactive</option>
                                    </select>
                                </div>
                            </div>
                            <div class="ln_solid"></div>
                            <div class="form-group text-center">
                                <div class="col-md-9 col-sm-9 col-xs-12 col-md-offset-3">
                                    <button type="reset" class="btn btn-warning"><i class="ace-icon fa fa-refresh"></i> Reset</button>
                                    <button type="submit" class="btn btn-success"><i class="ace-icon fa fa-check"></i> Save</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="x_panel">
                    <div class="x_title"><h2>Testimonials List</h2><div class="clearfix"></div></div>
                    <div class="x_content">
                        <table id="datatable-buttons" class="table table-striped table-bordered">
                            <thead><tr><th>#</th><th>Image</th><th>Name</th><th>Status</th><th>Action</th></tr></thead>
                            <tbody>
                            <% if (testimonials && testimonials.length > 0) { %>
                            <% testimonials.forEach((t, k) => { %>
                            <tr>
                                <td><%= k+1 %></td>
                                <td><% if(t.image){ %><img width="60px" height="45px" src="<%= t.image %>" alt="<%= t.name %>"><% } %></td>
                                <td><%= t.name %></td>
                                <td><span class="label label-<%= t.status === 'active' ? 'success' : 'warning' %>"><%= t.status %></span></td>
                                <td>
                                    <a title="Edit" class="label label-success lbl_pad" href="/admin/testimonials/<%= t._id %>/edit"><i class="ace-icon fa fa-pencil"></i></a>
                                    <a title="Delete" class="label label-danger lbl_pad" href="#" data-toggle="modal" onclick="deleteItem('<%= t._id %>','<%= t.name %>')" data-target=".bs-delete-modal-sm">&nbsp;<i class="ace-icon fa fa-trash-o"></i>&nbsp;</a>
                                </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                            <tr><td colspan="5"><div class="alert alert-warning">No testimonials found.</div></td></tr>
                            <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade bs-delete-modal-sm" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm"><div class="modal-content">
        <div class="modal-header" style="background:black;"><button type="button" class="close" data-dismiss="modal"><span>×</span></button><h4 class="modal-title">Confirm Delete</h4></div>
        <div class="modal-body"><h5 id="tagid"></h5><h5 id="tagname"></h5><h4><strong>Are you sure?</strong></h4></div>
        <div class="modal-footer">
            <button type="button" class="btn btn-primary" data-dismiss="modal">No</button>
            <button type="button" class="btn btn-danger id-btn-delete" data-dismiss="modal">Yes</button>
        </div>
    </div></div>
</div>
<script src="/Adminassets/vendors/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="/Adminassets/vendors/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
<script>
$(document).ready(function(){ if($('#datatable-buttons').length){ $('#datatable-buttons').DataTable(); } });
function deleteItem(id, name) {
    document.getElementById("tagid").innerHTML = 'ID: ' + id;
    document.getElementById("tagname").innerHTML = 'Name: ' + name;
    $(".id-btn-delete").off('click').on('click', function(){ location.href = '/admin/testimonials/' + id + '/delete'; });
}
</script>
