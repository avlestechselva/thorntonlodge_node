<div class="right_col" role="main">
    <div class="">
        <% if (error) { %><div class="alert alert-danger alert-dismissible"><button type="button" class="close" data-dismiss="alert"><i class="fa fa-times"></i></button><%= error %></div><% } %>
        <div class="page-title"><div class="title_left"><h3>Create Category</h3></div></div>
        <div class="clearfix"></div>
        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                <div class="x_panel">
                    <div class="x_title"><h2>Category Information</h2><div class="clearfix"></div></div>
                    <div class="x_content"><br>
                        <form action="/admin/categories" method="POST" class="form-horizontal form-label-left">
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Category Name</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <input type="text" name="name" class="form-control" placeholder="Category name ..." required oninput="autoSlug(this.value)">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12">Slug</label>
                                <div class="col-md-9 col-sm-9 col-xs-12">
                                    <input type="text" name="slug" id="slug" class="form-control" placeholder="category-slug ...">
                                </div>
                            </div>
                            <div class="ln_solid"></div>
                            <div class="form-group text-center">
                                <div class="col-md-9 col-sm-9 col-xs-12 col-md-offset-3">
                                    <a href="/admin/categories" class="btn btn-danger"><i class="ace-icon fa fa-arrow-left"></i> Back</a>
                                    <button type="submit" class="btn btn-success"><i class="ace-icon fa fa-check"></i> Save</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
function autoSlug(val) {
    document.getElementById('slug').value = val.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
</script>
