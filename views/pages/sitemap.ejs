<section class="banner scroll-animate parallax-hero" style="background: linear-gradient(rgba(44, 62, 80, 0.7), rgba(44, 62, 80, 0.7)), url(/images/slider/THORNTON LODGE_6425.jpg) no-repeat center; background-size: cover; padding: 120px 0 80px 0; background-attachment: fixed;">
    <div class="container"><div class="row justify-content-center"><div class="col-lg-10 text-center">
        <h1 style="font-size: 48px; font-weight: 700; color: white; text-shadow: 2px 2px 10px rgba(0,0,0,0.5);">Sitemap</h1>
    </div></div></div>
</section>

<section style="background: #f9f9f9; padding: 80px 0;">
    <div class="container">
        <div style="background: white; border-radius: 15px; box-shadow: 0 10px 40px rgba(0,0,0,0.08); padding: 40px; margin: 0 auto; max-width: 900px;">
            <h4 style="color: #2C3E50; font-weight: 700; margin-bottom: 30px;">Thornton Lodge - Sitemap</h4>
            <ul style="list-style: none; padding: 0; margin: 0;">
                <li style="background: #ddd; padding: 10px; margin: 10px 0; font-weight: 600;">Main Pages <span style="padding: 0 10px; color: #555;">18 pages</span></li>
                <% [
                    {href: '/', label: 'Thornton Lodge - Home'},
                    {href: '/about', label: 'About Us'},
                    {href: '/accommodation', label: 'Accommodation'},
                    {href: '/facilities', label: 'Facilities'},
                    {href: '/activities', label: 'Activities & Events'},
                    {href: '/cuisine', label: 'Cuisine'},
                    {href: '/gallery', label: 'Gallery'},
                    {href: '/our-team', label: 'Our Team'},
                    {href: '/testimonials', label: 'Testimonials'},
                    {href: '/admission-criteria', label: 'Admission Criteria'},
                    {href: '/principal-of-care', label: 'Principal of Care'},
                    {href: '/st-christophers', label: 'St Christophers'},
                    {href: '/staff-training', label: 'Staff Training'},
                    {href: '/job-vacancies', label: 'Job Vacancies'},
                    {href: '/bed-vacancies', label: 'Bed Availability'},
                    {href: '/blog', label: 'News & Blog'},
                    {href: '/contact', label: 'Contact Us'},
                    {href: '/privacy-policy', label: 'Privacy Policy'}
                ].forEach(item => { %>
                <li style="border-bottom: 1px solid #ddd; padding: 8px 10px;">
                    <a href="<%= item.href %>" style="color: #7BA5C7; text-decoration: none; font-size: 15px;"><%= item.label %></a>
                </li>
                <% }) %>
            </ul>
        </div>
    </div>
</section>
