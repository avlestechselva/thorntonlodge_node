<section class="hero-about banner scroll-animate parallax-hero">
    <div class="container" style="max-width: 1600px; padding: 0 40px;">
        <div class="hero-content">
            <h1>Who We Are</h1>
            <p style="font-size: 20px; max-width: 800px; margin: 0 auto; line-height: 1.8;">A calm, cheerful and relaxed family-like environment pervades throughout our home.</p>
