<section class="banner scroll-animate parallax-hero" style="background: linear-gradient(rgba(44, 62, 80, 0.7), rgba(44, 62, 80, 0.7)), url(/images/slider/THORNTON LODGE_6425.jpg) no-repeat center; background-size: cover; padding: 160px 0 120px 0; background-attachment: fixed;">
    <div class="container"><div class="row justify-content-center"><div class="col-lg-10 text-center hero-content">
        <h1 style="font-size: 52px; font-weight: 700; color: white; text-shadow: 2px 2px 10px rgba(0,0,0,0.5);">Our Rooms</h1>
        <p style="font-size: 24px; color: white; margin-bottom: 20px; text-shadow: 1px 1px 8px rgba(0,0,0,0.4);">Comfortable and Homely Accommodation</p>
    </div></div></div>
</section>

<section style="background: linear-gradient(135deg, #F0F7FA 0%, #E8F4F8 100%); padding: 100px 0;">
    <div class="container">
        <div class="modern-section-title scroll-animate" style="margin-bottom: 60px;">
            <div class="title-tag">Accommodation</div>
            <h3>Our Rooms</h3>
            <div class="title-underline"></div>
        </div>
        <div class="row">
            <% if (rooms && rooms.length > 0) { %>
            <% rooms.forEach(room => { %>
            <div class="col-lg-4 col-md-6 mb-4 scroll-animate-zoom">
                <div style="background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.08); transition: all 0.3s ease; height: 100%;" class="ripple">
                    <div style="position: relative;">
                        <img src="<%= room.cover_image %>" alt="<%= room.title %>" style="width: 100%; height: 250px; object-fit: cover;">
                    </div>
                    <div style="padding: 25px;">
                        <h4 style="font-size: 22px; font-weight: 700; color: #2C3E50; margin-bottom: 15px;"><%= room.title %></h4>
                        <p style="font-size: 15px; color: #666; line-height: 1.7; margin-bottom: 20px;"><%= room.excerpt %></p>
                        <a href="/room/<%= room.slug %>" style="display: inline-block; background: linear-gradient(135deg, #7BA5C7 0%, #6B94B5 100%); color: white; padding: 12px 30px; border-radius: 50px; font-weight: 700; text-decoration: none;" class="ripple">Read More</a>
                    </div>
                </div>
            </div>
            <% }) %>
            <% } else { %>
            <div class="col-12 text-center">
                <p style="color: #555;">No rooms found.</p>
            </div>
            <% } %>
        </div>
    </div>
</section>
