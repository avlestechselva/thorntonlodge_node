<section class="banner scroll-animate parallax-hero" style="background: linear-gradient(rgba(44, 62, 80, 0.6), rgba(44, 62, 80, 0.7)), url(/images/slider/FLOWERS11.jpg) no-repeat center center; background-size: cover; min-height: 400px; display: flex; align-items: center; justify-content: center; color: white; text-align: center; background-attachment: fixed;">
    <div class="container"><div class="hero-content">
        <h1 style="font-size: 56px; font-weight: 600; margin-bottom: 20px; text-shadow: 2px 2px 10px rgba(0,0,0,0.3);">Admission Criteria</h1>
        <p style="font-size: 20px; max-width: 700px; margin: 20px auto 0; line-height: 1.8;">Information about our admission process and eligibility criteria</p>
    </div></div>
</section>
<section style="background: #ffffff; padding: 100px 0;">
    <div class="container-fluid" style="max-width: 1600px; padding: 0 20px;">
        <div class="modern-section-title scroll-animate">
            <div class="title-tag">ADMISSION</div>
            <h3>Admission Criteria</h3>
            <div class="title-underline"></div>
        </div>
        <div class="row">
            <div class="col-lg-8 mb-4 scroll-animate-right">
                <div style="background: white; border-radius: 20px; padding: 40px; box-shadow: 0 10px 40px rgba(0,0,0,0.08);">
                    <p style="font-size: 17px; line-height: 1.8; color: #555; margin-bottom: 20px;">Thornton Lodge is a Residential Care Home for Adults and Older People with Mental Health Problems. We accept residents who meet our specific care criteria.</p>
                    <h4 style="color: #7BA5C7; font-weight: 700; margin-bottom: 20px;">Who We Care For</h4>
                    <ul style="list-style: none; padding: 0; margin: 0 0 25px 0;">
                        <% [
                            'Adults aged 18 and over with mental health needs',
                            'Older people with mental health conditions',
                            'Individuals with a history of mental illness requiring residential care',
                            'Those who need a supported, structured living environment',
                            'Residents requiring medication management and support'
                        ].forEach(item => { %>
                        <li style="padding: 12px 0 12px 35px; position: relative; font-size: 16px; line-height: 1.8; color: #555;">
                            <span style="position: absolute; left: 0; top: 12px; color: #7BA5C7; font-weight: bold; font-size: 18px;">✓</span>
                            <%= item %>
                        </li>
                        <% }) %>
                    </ul>
                    <h4 style="color: #7BA5C7; font-weight: 700; margin-bottom: 20px;">Referral Process</h4>
                    <p style="font-size: 17px; line-height: 1.8; color: #555; margin-bottom: 20px;">Referrals can be made by Social Workers, Community Psychiatric Nurses, Psychiatrists, GPs, or family members. We welcome enquiries from all sources and will assess each individual's needs carefully.</p>
                    <p style="font-size: 17px; line-height: 1.8; color: #555; margin-bottom: 0;">For more information about our admission process, please contact us at <strong>020 8684 1056</strong> or email <a href="mailto:admin@thorntonlodgecare.com" style="color: #7BA5C7; font-weight: 600; text-decoration: none;">admin@thorntonlodgecare.com</a></p>
                </div>
            </div>
            <div class="col-lg-4 mb-4 scroll-animate-left">
                <div style="background: linear-gradient(135deg, #7BA5C7 0%, #6B94B5 100%); border-radius: 20px; padding: 40px; color: white; box-shadow: 0 15px 50px rgba(123, 165, 199, 0.3); margin-bottom: 30px;">
                    <h4 style="font-size: 22px; font-weight: 700; margin-bottom: 15px; color: white;">Get in Touch</h4>
                    <p style="font-size: 16px; line-height: 1.7; margin-bottom: 20px; color: rgba(255,255,255,0.9);">For placement enquiries, please contact us:</p>
                    <p style="margin-bottom: 10px; color: rgba(255,255,255,0.9);"><i class="fa fa-phone" style="margin-right: 10px;"></i>020 8684 1056</p>
                    <p style="margin-bottom: 20px; color: rgba(255,255,255,0.9);"><i class="fa fa-envelope" style="margin-right: 10px;"></i>admin@thorntonlodgecare.com</p>
                    <a href="/contact" style="display: inline-block; background: white; color: #7BA5C7; padding: 12px 30px; border-radius: 50px; font-weight: 700; text-decoration: none; transition: all 0.3s ease;">Contact Us</a>
                </div>
            </div>
        </div>
    </div>
</section>
