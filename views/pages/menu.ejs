<section class="banner scroll-animate parallax-hero" style="background: linear-gradient(rgba(44, 62, 80, 0.7), rgba(44, 62, 80, 0.7)), url(/images/slider/THORNTON LODGE_6425.jpg) no-repeat center; background-size: cover; padding: 120px 0 80px 0; background-attachment: fixed;">
    <div class="container"><div class="row justify-content-center"><div class="col-lg-10 text-center">
        <h1 style="font-size: 48px; font-weight: 700; color: white; text-shadow: 2px 2px 10px rgba(0,0,0,0.5);">Our Menu</h1>
    </div></div></div>
</section>

<section style="background: linear-gradient(135deg, #F0F7FA 0%, #E8F4F8 100%); padding: 80px 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <div style="background: white; border-radius: 20px; padding: 60px; box-shadow: 0 10px 40px rgba(0,0,0,0.08);">
                    <i class="fa fa-cutlery" style="font-size: 64px; color: #7BA5C7; margin-bottom: 30px; display: block;"></i>
                    <h3 style="font-weight: 700; color: #2C3E50; margin-bottom: 20px;">Menu of the Year</h3>
                    <p style="color: #555; font-size: 17px; line-height: 1.8; margin-bottom: 35px;">At Thornton Lodge, we pride ourselves on providing nutritious, delicious and varied meals for our residents. Our menu is carefully planned to meet dietary requirements and personal preferences.</p>
                    <% if (typeof menu_pdf !== 'undefined' && menu_pdf) { %>
                    <a href="<%= menu_pdf %>" target="_blank" style="display: inline-block; background: linear-gradient(135deg, #7BA5C7 0%, #6B94B5 100%); color: white; padding: 18px 45px; border-radius: 50px; font-weight: 700; text-decoration: none; font-size: 18px; box-shadow: 0 8px 25px rgba(123, 165, 199, 0.4);" class="ripple">
                        <i class="fa fa-file-pdf-o" style="margin-right: 10px;"></i>View Menu PDF
                    </a>
                    <% } else { %>
                    <p style="color: #777; font-style: italic;">Menu PDF will be available soon. Please contact us for details.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>
