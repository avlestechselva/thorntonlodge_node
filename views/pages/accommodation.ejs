<section class="banner scroll-animate parallax-hero" style="background: linear-gradient(rgba(44, 62, 80, 0.6), rgba(44, 62, 80, 0.7)), url(/images/slider/THORNTON LODGE_6430.jpg) no-repeat center center; background-size: cover; min-height: 450px; display: flex; align-items: center; justify-content: center; color: white; text-align: center; background-attachment: fixed;">
    <div class="container" style="max-width: 1600px; padding: 0 40px;">
        <div class="hero-content">
            <h1 style="font-size: 56px; font-weight: 600; margin-bottom: 20px; text-shadow: 2px 2px 10px rgba(0,0,0,0.3);">Accommodation</h1>
            <p style="font-size: 20px; max-width: 700px; margin: 20px auto 0; line-height: 1.8;">Comfortable, safe and welcoming living spaces designed for your wellbeing</p>
        </div>
    </div>
</section>

<section style="background: #ffffff; padding: 100px 0;">
    <div class="container-fluid" style="max-width: 1600px; padding: 0 20px;">
        <div class="row align-items-center">
            <div class="col-lg-8 mb-4 scroll-animate-right">
                <div style="background: white; border-radius: 20px; padding: 50px; box-shadow: 0 10px 40px rgba(0,0,0,0.08); height: 100%;">
                    <h3 style="color: #7BA5C7; font-weight: 700; margin-bottom: 30px; font-size: 32px;">Our Living Spaces</h3>
                    <p style="font-size: 17px; line-height: 1.9; color: #555; margin-bottom: 20px;">Thornton Lodge offers accommodation for 45 residents and proudly offers all single rooms, some of which are ensuite.</p>
                    <p style="font-size: 17px; line-height: 1.9; color: #555; margin-bottom: 20px;">The facilities include 2 large dining areas, 4 ground floor sitting areas, 2 conservatories and small diner / lounge on the first floor for those service users who may feel happier to stay nearer to their bedrooms.</p>
                    <p style="font-size: 17px; line-height: 1.9; color: #555; margin-bottom: 20px;">There are 2 passenger lifts for those who are unable to use the stairs.</p>
                    <p style="font-size: 17px; line-height: 1.9; color: #555; margin-bottom: 20px;">All the rooms have wash basins, help line system, fire prevention devices and electric points in line with the Registered Authorities.</p>
                    <p style="font-size: 17px; line-height: 1.9; color: #555; margin-bottom: 20px;">The decoration is individualised and furniture is of good and practicable standard. Any item of significance value may be brought in by a service user as it helps bring in homeliness and provides a sense of familiarity.</p>
                    <p style="font-size: 17px; line-height: 1.9; color: #555; margin-bottom: 0;">Visit our <a href="/gallery" style="color: #7BA5C7; font-weight: 600; text-decoration: none;">Gallery</a> to view our home.</p>
                </div>
            </div>
            <div class="col-lg-4 mb-4 scroll-animate-left">
                <div style="width: 100%; height: 400px; border-radius: 20px; overflow: hidden; box-shadow: 0 15px 50px rgba(0,0,0,0.15);" class="float-animation">
                    <img src="/images/accomensation.jpg" alt="Accommodation" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
            </div>
        </div>
    </div>
</section>

<section style="background: linear-gradient(135deg, #F0F7FA 0%, #E8F4F8 100%); padding: 100px 0;">
    <div class="container-fluid" style="max-width: 1600px; padding: 0 20px;">
        <div class="modern-section-title scroll-animate">
            <div class="title-tag">FACILITIES</div>
            <h3>Key Features</h3>
            <div class="title-underline"></div>
        </div>
        <div class="row">
            <% [{icon:'fa-bed',title:'45 Single Rooms'},{icon:'fa-arrows-v',title:'2 Passenger Lifts'},{icon:'fa-users',title:'4 Sitting Areas'},{icon:'fa-cutlery',title:'2 Dining Areas'}].forEach((f,i) => { %>
            <div class="col-lg-3 col-md-6 mb-4 scroll-animate-zoom">
                <div style="background: linear-gradient(135deg, #F0F7FA 0%, #E8F4F8 100%); border-radius: 15px; padding: 25px; text-align: center; margin-bottom: 20px; transition: all 0.3s ease; border-bottom: 4px solid #7BA5C7;" class="ripple">
                    <i class="fa <%= f.icon %>" style="font-size: 40px; color: #7BA5C7; margin-bottom: 15px; display: block;"></i>
                    <h5 style="font-size: 18px; font-weight: 700; color: #2C3E50; margin: 0;"><%= f.title %></h5>
                </div>
            </div>
            <% }) %>
        </div>
    </div>
</section>

<% if (rooms && rooms.length > 0) { %>
<section style="background: #ffffff; padding: 100px 0;">
    <div class="container-fluid" style="max-width: 1600px; padding: 0 20px;">
        <div class="modern-section-title scroll-animate">
            <div class="title-tag">AVAILABILITY</div>
            <h3>Available Rooms</h3>
            <div class="title-underline"></div>
        </div>
        <div class="row">
            <% rooms.forEach(room => { %>
            <div class="col-lg-4 col-md-6 mb-4 scroll-animate-zoom">
                <div style="background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.08); transition: all 0.3s ease; margin-bottom: 30px; height: 100%;" class="ripple">
                    <div style="position: relative;">
                        <img src="<%= room.cover_image %>" alt="<%= room.title %>" style="width: 100%; height: 250px; object-fit: cover;">
                        <span style="position: absolute; top: 20px; right: 20px; background: linear-gradient(135deg, #7BA5C7 0%, #6B94B5 100%); color: white; padding: 8px 20px; border-radius: 20px; font-weight: 700; font-size: 13px; box-shadow: 0 4px 15px rgba(123, 165, 199, 0.4);">Available</span>
                    </div>
                    <div style="padding: 25px;">
                        <h4 style="font-size: 22px; font-weight: 700; color: #2C3E50; margin-bottom: 15px;"><%= room.title %></h4>
                        <p style="font-size: 15px; color: #666; line-height: 1.7; margin-bottom: 20px;"><%= room.excerpt %></p>
                        <a href="/contact" style="display: inline-block; background-image: linear-gradient(135deg, #7BA5C7 0%, #6B94B5 100%); color: white; padding: 12px 30px; border-radius: 50px; font-weight: 700; text-decoration: none; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(123, 165, 199, 0.3);" class="ripple">
                            <i class="fa fa-envelope" style="margin-right: 8px;"></i>Enquire Now
                        </a>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
        <div class="text-center scroll-animate" style="margin-top: 40px;">
            <a href="/bed-vacancies" style="display: inline-block; background-image: linear-gradient(135deg, #7BA5C7 0%, #6B94B5 100%); color: white; padding: 15px 50px; border-radius: 50px; font-weight: 700; text-decoration: none; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(123, 165, 199, 0.3); font-size: 16px;" class="ripple">
                See More Rooms <i class="fa fa-arrow-right" style="margin-left: 10px;"></i>
            </a>
        </div>
    </div>
</section>
<% } %>
