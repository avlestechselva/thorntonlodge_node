<section class="banner scroll-animate parallax-hero" style="background: linear-gradient(rgba(44, 62, 80, 0.6), rgba(44, 62, 80, 0.7)), url(/images/slider/our_team.jpg) no-repeat center center; background-size: cover; min-height: 400px; display: flex; align-items: center; justify-content: center; color: white; text-align: center; background-attachment: fixed;">
    <div class="container"><div class="hero-content">
        <h1 style="font-size: 56px; font-weight: 600; margin-bottom: 20px; text-shadow: 2px 2px 10px rgba(0,0,0,0.3);">Job Vacancies</h1>
        <p style="font-size: 20px; max-width: 700px; margin: 20px auto 0; line-height: 1.8;">Join our dedicated team at Thornton Lodge</p>
    </div></div>
</section>
<section style="background: #ffffff; padding: 100px 0;">
    <div class="container-fluid" style="max-width: 1600px; padding: 0 20px;">
        <div class="modern-section-title scroll-animate">
            <div class="title-tag">CAREERS</div>
            <h3>Work With Us</h3>
            <div class="title-underline"></div>
        </div>
        <div class="row">
            <div class="col-lg-8 mb-4 scroll-animate-right">
                <div style="background: white; border-radius: 20px; padding: 50px; box-shadow: 0 10px 40px rgba(0,0,0,0.08);">
                    <p style="font-size: 17px; line-height: 1.9; color: #555; margin-bottom: 25px;">Thornton Lodge is always looking for dedicated, compassionate individuals to join our team. We offer a rewarding working environment where you can make a real difference to people's lives.</p>
                    <p style="font-size: 17px; line-height: 1.9; color: #555; margin-bottom: 25px;">We welcome applications from people with a range of backgrounds and experience levels. Full training and support will be provided for successful candidates.</p>
                    <h4 style="color: #7BA5C7; font-weight: 700; margin-bottom: 20px;">Current Opportunities</h4>
                    <p style="font-size: 17px; line-height: 1.9; color: #555; margin-bottom: 25px;">We regularly have vacancies for:</p>
                    <ul style="list-style: none; padding: 0; margin: 0 0 30px 0;">
                        <% ['Care Workers', 'Senior Care Workers', 'Night Support Workers', 'Activities Coordinator', 'Domestic Staff', 'Kitchen Staff'].forEach(role => { %>
                        <li style="padding: 10px 0 10px 35px; position: relative; font-size: 16px; line-height: 1.8; color: #555;">
                            <span style="position: absolute; left: 0; top: 10px; color: #7BA5C7; font-weight: bold; font-size: 18px;">✓</span>
                            <%= role %>
                        </li>
                        <% }) %>
                    </ul>
                    <p style="font-size: 17px; line-height: 1.9; color: #555; margin-bottom: 0;">To enquire about job opportunities, please contact us at <strong>020 8684 1056</strong> or email <a href="mailto:admin@thorntonlodgecare.com" style="color: #7BA5C7; font-weight: 600; text-decoration: none;">admin@thorntonlodgecare.com</a></p>
                </div>
            </div>
            <div class="col-lg-4 mb-4 scroll-animate-left">
                <div style="background: linear-gradient(135deg, #7BA5C7 0%, #6B94B5 100%); border-radius: 20px; padding: 40px; color: white; box-shadow: 0 15px 50px rgba(123, 165, 199, 0.3); margin-bottom: 30px;">
                    <h4 style="font-size: 22px; font-weight: 700; margin-bottom: 20px; color: white;">Why Work With Us?</h4>
                    <ul style="list-style: none; padding: 0; margin: 0;">
                        <% ['Competitive pay rates', 'Comprehensive training', 'Supportive team environment', 'Career development opportunities', 'Employee recognition programmes'].forEach(b => { %>
                        <li style="padding: 10px 0; color: rgba(255,255,255,0.9); font-size: 16px; border-bottom: 1px solid rgba(255,255,255,0.2);">
                            <i class="fa fa-check" style="margin-right: 10px; color: rgba(255,255,255,0.7);"></i><%= b %>
                        </li>
                        <% }) %>
                    </ul>
                </div>
                <a href="/contact" style="display: block; background: white; color: #7BA5C7; padding: 18px 30px; border-radius: 50px; font-weight: 700; text-decoration: none; text-align: center; box-shadow: 0 8px 25px rgba(0,0,0,0.1); transition: all 0.3s ease; font-size: 16px;">
                    <i class="fa fa-paper-plane" style="margin-right: 10px;"></i>Apply Now
                </a>
            </div>
        </div>
    </div>
</section>
