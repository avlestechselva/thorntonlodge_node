<!-- Interactive Timeline -->
<section style="background: #ffffff; padding: 100px 0;">
    <div class="container-fluid" style="max-width: 1600px; padding: 0 20px;">
        <div class="modern-section-title scroll-animate" style="margin-bottom: 80px;">
            <div class="title-tag">Our Journey</div>
            <h3 style="font-size: 48px; margin-top: 20px;">35+ Years of Excellence</h3>
            <div class="title-underline"></div>
        </div>
        <div class="timeline" style="position: relative; max-width: 1000px; margin: 60px auto;">
            <div style="position: absolute; left: 50%; transform: translateX(-50%); width: 4px; height: 100%; background: linear-gradient(180deg, #7BA5C7 0%, #7BA5C7 100%);"></div>
            <% [
                {year: '1987', title: 'Foundation', desc: 'Thornton Lodge was established to provide quality residential care for adults with mental health needs.'},
                {year: '2000', title: 'Facility Expansion', desc: 'Major renovations and expansion to accommodate more residents with enhanced facilities.'},
                {year: '2008', title: 'CQC Registration', desc: 'Officially registered under the Health and Social Care Act 2008 by the Care Quality Commission.'},
                {year: '2015', title: '"Good" Rating Achieved', desc: 'Received "Good" rating from CQC, recognizing our commitment to quality care standards.'},
                {year: '2025', title: 'Continued Excellence', desc: 'Over 35 years of providing compassionate, professional care to our community.'}
            ].forEach((item, i) => { %>
            <div class="timeline-item" style="position: relative; margin-bottom: 50px; opacity: 0; transform: translateY(30px); transition: all 0.6s ease;">
                <div class="timeline-year" style="position: absolute; left: 50%; transform: translateX(-50%); background: white; width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 18px; color: #7BA5C7; box-shadow: 0 0 0 8px rgba(110, 207, 233, 0.2); z-index: 2;"><%= item.year %></div>
                <div class="timeline-content" style="background: white; padding: 25px 30px; border-radius: 15px; box-shadow: 0 8px 30px rgba(0,0,0,0.1); transition: all 0.3s ease; <%= i % 2 === 0 ? 'margin-right: calc(50% + 40px); text-align: right;' : 'margin-left: calc(50% + 40px);' %>">
                    <h4 style="font-size: 20px; font-weight: 700; color: #333; margin-bottom: 10px;"><%= item.title %></h4>
                    <p style="color: #666; line-height: 1.6; margin: 0;"><%= item.desc %></p>
                </div>
            </div>
            <% }) %>
        </div>
    </div>
</section>

