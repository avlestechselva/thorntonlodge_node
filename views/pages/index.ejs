            <div class="col-12">
                <div class="text-center scroll-animate" style="margin-top: 30px; margin-bottom: 40px;">
                    <a href="/bed-vacancies" class="btn btn-info btn-lg ripple" style="background: linear-gradient(135deg, #7BA5C7 0%, #4080B8 100%); padding: 16px 50px; border: none; border-radius: 30px; transition: all 0.3s ease; box-shadow: 0 6px 25px rgba(110, 207, 233, 0.4); font-size: 18px; font-weight: 600; color: white; text-decoration: none; display: inline-block;">See More Rooms <i class="fa fa-arrow-right" style="margin-left: 10px;"></i></a>
