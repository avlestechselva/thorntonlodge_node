<!doctype html>
<html lang="en">
<head>
    <title>Dashboard Login - Thornton Lodge</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="/Adminassets/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="/Adminassets/assets/vendor/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="/Adminassets/assets/vendor/linearicons/style.css">
    <link rel="stylesheet" href="/Adminassets/assets/css/main.css">
    <link rel="stylesheet" href="/Adminassets/assets/css/demo.css">
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700" rel="stylesheet">
</head>
<body>
<div id="wrapper">
    <div class="vertical-align-wrap">
        <div class="vertical-align-middle">
            <div class="auth-box">
                <div class="left">
                    <div class="content">
                        <div class="header">
                            <p class="lead">Login to your account</p>
                        </div>
                        <% if (error) { %>
                        <div class="alert alert-danger alert-dismissible" style="margin-bottom: 15px;">
                            <button type="button" class="close" data-dismiss="alert"><i class="fa fa-times"></i></button>
                            <%= error %>
                        </div>
                        <% } %>
                        <form class="form-auth-small" method="POST" action="/login">

                            <div class="form-group">
                                <label class="control-label sr-only">Email</label>
                                <input type="email" class="form-control" name="email" placeholder="Email" required autofocus>
                            </div>
                            <div class="form-group">
                                <label class="control-label sr-only">Password</label>
                                <input type="password" class="form-control" name="password" placeholder="Password" required>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg btn-block">LOGIN</button>
                            <div class="bottom">
                                <span class="helper-text"><i class="fa fa-lock"></i></span>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="right">
                    <div class="overlay"></div>
                    <div class="content text">
                        <div class="logo text-center"><img width="50%" src="/images/logo.png" alt="Logo"></div>
                        <h1 class="heading">Welcome to Thornton Lodge Dashboard</h1>
                    </div>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>
<script src="/Adminassets/assets/js/jquery.min.js"></script>
<script src="/Adminassets/assets/js/bootstrap.min.js"></script>
</body>
</html>
