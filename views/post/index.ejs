<section class="banner scroll-animate parallax-hero" style="background: linear-gradient(rgba(44, 62, 80, 0.7), rgba(44, 62, 80, 0.7)), url(/images/slider/thorntonlodgeb10.jpg) no-repeat center; background-size: cover; padding: 120px 0 80px 0; background-attachment: fixed;">
    <div class="container"><div class="row justify-content-center"><div class="col-lg-10 text-center">
        <h1 style="font-size: 52px; font-weight: 700; color: white; text-shadow: 2px 2px 10px rgba(0,0,0,0.5);">News &amp; Blog</h1>
    </div></div></div>
</section>

<section style="background: #f9f9f9; padding: 80px 0;">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <% if (posts && posts.length > 0) { %>
                <% posts.forEach(post => { %>
                <div class="card" style="overflow: hidden; border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); margin-bottom: 40px; border: none;">
                    <a href="/tag-<%= post.category ? post.category.slug : 'news' %>/<%= post.slug %>">
                        <img class="card-img-top" src="<%= post.image %>" alt="<%= post.title %>" style="width: 100%; height: 300px; object-fit: cover;">
                    </a>
                    <div class="card-body" style="padding: 30px;">
                        <p style="color: #777; font-size: 14px; margin-bottom: 10px;"><span>By: <%= post.author %></span> &nbsp;|&nbsp; <%= new Date(post.createdAt).toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}) %></p>
                        <h5 class="card-title" style="font-size: 22px; font-weight: 700; margin-bottom: 15px;">
                            <a href="/tag-<%= post.category ? post.category.slug : 'news' %>/<%= post.slug %>" style="color: #2C3E50; text-decoration: none;"><%= post.title %></a>
                        </h5>
                        <p class="card-text" style="color: #666; line-height: 1.7; margin-bottom: 20px;"><%= post.excerpt %></p>
                        <a href="/tag-<%= post.category ? post.category.slug : 'news' %>/<%= post.slug %>" style="display: inline-block; background: linear-gradient(135deg, #7BA5C7 0%, #6B94B5 100%); color: white; padding: 10px 25px; border-radius: 50px; text-decoration: none; font-weight: 600;">Read More</a>
                    </div>
                    <div class="card-footer" style="background: #f9f9f9; padding: 15px 30px;">
                        <small>Tag: </small>
                        <% if (post.category) { %>
                        <a href="/category-<%= post.category.slug %>" style="color: #7BA5C7; font-size: 13px;"><%= post.category.name %></a>
                        <% } %>
                    </div>
                </div>
                <% }) %>
                <% } else { %>
                <div style="background: white; padding: 30px; border-radius: 12px; text-align: center;">
                    <i class="fa fa-info-circle" style="font-size: 32px; color: #7BA5C7; margin-bottom: 15px; display: block;"></i>
                    <p style="color: #555;">No Blog results found</p>
                </div>
                <% } %>

                <% if (pages > 1) { %>
                <nav style="margin-top: 20px;"><ul class="pagination justify-content-center">
                    <% for (let i = 1; i <= pages; i++) { %>
                    <li class="page-item <%= page === i ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %>"><%= i %></a></li>
                    <% } %>
                </ul></nav>
                <% } %>
            </div>

            <aside class="col-lg-4">
                <div style="background: white; border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); padding: 30px; margin-bottom: 30px;">
                    <h4 style="font-weight: 700; color: #2C3E50; margin-bottom: 20px; font-size: 18px;">TAGS</h4>
                    <ul class="list-group" style="list-style: none; padding: 0;">
                        <% if (tags && tags.length > 0) { %>
                        <% tags.forEach((tag, k) => { %>
                        <a href="/category-<%= tag.slug %>" style="text-decoration: none;">
                            <li style="padding: 10px 15px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; color: <%= k === 0 ? '#7BA5C7' : '#555' %>; font-weight: <%= k === 0 ? '600' : '400' %>;">
                                <%= tag.name %>
                                <span style="background: #7BA5C7; color: white; padding: 2px 8px; border-radius: 10px; font-size: 12px;"><%= tag.postCount || 0 %></span>
                            </li>
                        </a>
                        <% }) %>
                        <% } else { %>
                        <li style="color: #555; padding: 10px;">No results found</li>
                        <% } %>
                    </ul>
                </div>

                <% if (pop_posts && pop_posts.length > 0) { %>
                <div style="background: white; border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); padding: 30px;">
                    <h4 style="font-weight: 700; color: #2C3E50; margin-bottom: 20px; font-size: 18px;">Top stories of the week</h4>
                    <% pop_posts.forEach(pp => { %>
                    <div style="display: flex; gap: 15px; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid #eee;">
                        <div style="flex-shrink: 0; width: 80px; height: 60px; overflow: hidden; border-radius: 8px;">
                            <img src="<%= pp.image %>" alt="<%= pp.title %>" style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                        <div>
                            <h5 style="font-size: 14px; font-weight: 600; margin-bottom: 5px;">
                                <a href="/tag-<%= pp.category ? pp.category.slug : 'news' %>/<%= pp.slug %>" style="color: #2C3E50; text-decoration: none;"><%= pp.title %></a>
                            </h5>
                            <p style="font-size: 12px; color: #777; margin: 0;"><%= new Date(pp.createdAt).toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}) %></p>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } %>
            </aside>
        </div>
    </div>
</section>
