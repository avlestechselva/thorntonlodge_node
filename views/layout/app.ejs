    .clean-nav-item.active .clean-nav-link { color: #7BA5C7 !important; }
    .dropdown-arrow { font-size: 13px; transition: transform 0.3s ease; }
    .clean-nav-item:hover .dropdown-arrow { transform: rotate(180deg); }
    .clean-dropdown { position: absolute; top: 100%; left: 0; background: white; min-width: 240px; padding: 12px 0; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.12); opacity: 0; visibility: hidden; transform: translateY(-10px); transition: all 0.3s ease; margin-top: 15px; border: 1px solid #f0f0f0; }
