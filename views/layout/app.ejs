        .modern-section-title h3 { font-size: 42px; font-weight: 800; color: #1a1a1a; margin: 0; letter-spacing: -1px; line-height: 1.2; }
        .modern-section-title .title-underline { width: 100px; height: 4px; background: linear-gradient(90deg, transparent 0%, #7BA5C7 50%, transparent 100%); margin: 25px auto 0; border-radius: 2px; }
        .ripple { position: relative; overflow: hidden; }
        @media (max-width: 768px) { .modern-section-title h3 { font-size: 32px; } }
