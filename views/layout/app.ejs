    .clean-nav-menu { display: flex; align-items: center; gap: 28px; list-style: none; margin: 0; padding: 0; }
    .clean-nav-item { position: relative; }
    .clean-nav-link { color: #2C3E50 !important; text-decoration: none; font-size: 16px; font-weight: 600; transition: color 0.3s ease; display: flex; align-items: center; gap: 6px; }
